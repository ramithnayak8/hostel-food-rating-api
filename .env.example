# Copy to .env: `cp .env.example .env`. Safe, commit-friendly defaults for local Docker Compose.
# NEVER commit a real .env. Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- App ---
ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
MAX_REQUEST_BODY_BYTES=65536

# --- Auth ---
JWT_SECRET=dev-only-change-me-to-a-long-random-string-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (compose service name "postgres"; use localhost:5432 when running the API on the host) ---
POSTGRES_USER=hostel
POSTGRES_PASSWORD=hostel-dev-password
POSTGRES_DB=hostel_food
DATABASE_URL=postgresql+psycopg://hostel:hostel-dev-password@postgres:5432/hostel_food
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Rate limiting (slowapi; point storage at redis://... when running several replicas) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_RATINGS=30/minute
RATE_LIMIT_STORAGE_URI=memory://

# --- Complaint flag ---
FLAG_THRESHOLD=2.0
FLAG_MIN_RATINGS=3

# --- Container entrypoint: run `alembic upgrade head` before starting (k8s sets false; its initContainer migrates) ---
RUN_MIGRATIONS=true

# --- Bootstrap admin used by scripts/create_admin.py and scripts/smoke_test.sh ---
ADMIN_EMAIL=warden@hostel.example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Hostel Warden

# --- pgAdmin (docker-compose.yml only) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin-dev-password

# --- Grafana (monitoring profile) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-dev-password

# --- docker-compose.prod.yml: image to pull ---
IMAGE=ghcr.io/your-github-user/hostel-food-rating-api:latest
