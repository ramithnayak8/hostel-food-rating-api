# Ansible inventory: one app server. In the lab it is the `app-server` container from
# docker-compose.yml; point ansible_host at a VM's IP to deploy there instead.
[app_servers]
app-server ansible_host=app-server

[app_servers:vars]
ansible_user=ansible
ansible_ssh_private_key_file=/keys/id_ed25519
ansible_python_interpreter=/usr/bin/python3
